# Server Port (Render automatically populates this)
PORT=8000

# MongoDB Connection String (Atlas / Local)
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/ecomstore?retryWrites=true&w=majority
# Alternatively:
# DB_URL=...
# MONGODB_URI=...

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (e.g. your Vercel deployment URL)
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
